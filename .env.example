# Copie ce fichier en ".env" et remplis les valeurs (ne jamais commiter le .env réel)

# Token du bot Discord (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# Clé API Minestrator (voir le panel Minestrator, section API/Développeur)
MINESTRATOR_API_KEY=

# ID du serveur Minecraft sur Minestrator (visible dans l'URL du panel ou dans les infos du serveur)
SERVER_ID=

# Optionnel : URL de base de l'API Minestrator si elle diffère de la valeur par défaut
# MINESTRATOR_API_BASE_URL=https://panel.minestrator.com/api

# Optionnel : nom exact d'un rôle Discord autorisé à utiliser /start et /status
# Laisse vide pour autoriser tout le monde
# ALLOWED_ROLE_NAME=Membre
