# Copie ce fichier en ".env" et remplis les valeurs (ne jamais commiter le .env réel)

# Token du bot Discord (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# Clé API Minestrator (panel Minestrator > Compte > Clés API : https://minestrator.com/my/account?section=api)
MINESTRATOR_API_KEY=

# ID de la MyBox (visible dans l'URL du panel, ex: .../mybox/12345/...)
MYBOX_ID=

# ID du serveur Minecraft dans cette MyBox (visible dans l'URL du serveur, ex: .../server/67890/...)
SERVER_ID=

# ID du salon Discord où poster les annonces automatiques (redémarrage périodique,
# alerte "serveur hors ligne"). Active le mode développeur Discord (Réglages > Avancés),
# puis clic droit sur le salon > "Copier l'identifiant".
# Laisse vide pour désactiver le redémarrage automatique et la veille hors-ligne.
ANNOUNCE_CHANNEL_ID=

# Optionnel : ID du salon où afficher le panneau de statistiques en direct
# (CPU, RAM, disque, joueurs, uptime). Laisse vide pour réutiliser ANNOUNCE_CHANNEL_ID ;
# si les deux sont vides, le panneau est désactivé.
# STATS_CHANNEL_ID=

# Optionnel : URL de base de l'API Minestrator (déjà correcte par défaut)
# MINESTRATOR_API_BASE_URL=https://mine.sttr.io

# Optionnel : intervalle entre deux redémarrages automatiques, en heures (défaut : 4)
# RESTART_INTERVAL_HOURS=4

# Optionnel : délai entre l'annonce et le redémarrage effectif automatique, en secondes (défaut : 30)
# RESTART_WARNING_SECONDS=30

# Optionnel : fréquence de vérification du statut pour la veille hors-ligne, en secondes (défaut : 120)
# STATUS_POLL_INTERVAL_SECONDS=120

# Optionnel : fréquence de rafraîchissement du panneau de statistiques, en secondes (défaut : 60)
# STATS_UPDATE_INTERVAL_SECONDS=60

# Optionnel : nom exact d'un rôle Discord autorisé à utiliser /stop. Laisse vide pour n'autoriser
# que les membres ayant la permission Discord "Gérer le serveur".
# /start, /restart et /status restent toujours ouverts à tous les membres.
# ADMIN_ROLE_NAME=Admin
